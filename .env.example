# ============================================================
# Tanaghum Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Public/IP traffic stays conservative. Authenticated SaaS users use isolated tenant/user buckets.
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTHENTICATED_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# --- PostgreSQL ---
DATABASE_URL=postgresql://tanaghum:tanaghum_dev@localhost:5432/tanaghum?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# MUST be at least 32 characters. MUST NOT use dev fallback in production/demo.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRY=24h

# --- Execution Kill Switches ---
# All live integrations disabled by default. Set to 'true' only with explicit approval.
EXTERNAL_EXECUTION_ENABLED=false
M5_WRITE_EXECUTION_ENABLED=false
POSTIZ_LIVE_ENABLED=false
CRM_LIVE_ENABLED=false
GHL_WRITE_BACK_ENABLED=false
GHL_OPERATIONS_API_VERSION=v3
GHL_OPERATION_WORKER_ENABLED=false
GHL_OPERATION_WORKER_INTERVAL_MS=10000
GHL_BREAK_GLASS_EXECUTION_ENABLED=false
GHL_CONTACT_UPSERT_ENABLED=false
GHL_CONTACT_TAGS_UPDATE_ENABLED=false
GHL_OPPORTUNITY_UPSERT_ENABLED=false
GHL_APPOINTMENT_UPSERT_ENABLED=false
GHL_WEBHOOK_ENABLED=false
GHL_WEBHOOK_REQUIRE_TIMESTAMP=false
GHL_WHATSAPP_SEND_ENABLED=false
WHATSAPP_LIVE_ENABLED=false
RENDERING_LIVE_ENABLED=false
RESOURCESPACE_LIVE_ENABLED=false
PAPERCLIP_SYNC_ENABLED=false
ANALYTICS_LIVE_ENABLED=false

# --- Internal Runtime Pilots ---
# R3: agentgateway dry-run policy mediation pilot.
# Keep disabled unless a sandbox policy endpoint and tenant runtime credential are configured.
AGENTGATEWAY_DRY_RUN_POLICY_ENABLED=false
AGENTGATEWAY_SANDBOX_POLICY_TOKEN=

# --- Demo Mode ---
DEMO_MODE=true

# --- LLM Provider (mock) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
GEMMA_BASE_URL=https://api.thesmartlabs.net/gemma4/v1
GEMMA_MODEL=gemma4-26b-a4b-canary
GEMMA_API_KEY=

# --- Postiz (mock) ---
POSTIZ_PROVIDER=mock
POSTIZ_API_URL=
POSTIZ_API_KEY=

# --- Messaging (mock) ---
MESSAGING_PROVIDER=mock
MESSAGING_CHANNEL=
SLACK_BOT_TOKEN=
WHATSAPP_API_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- CRM (mock) ---
CRM_PROVIDER=mock
CRM_API_URL=
CRM_API_KEY=
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Optional override. The official Ed25519 public key is built into the backend.
GHL_WEBHOOK_PUBLIC_KEY=
GHL_LEGACY_WEBHOOK_PUBLIC_KEY=

# --- Analytics (mock) ---
ANALYTICS_PROVIDER=mock

# --- Production Operations ---
# Server-only token used by Prometheus to scrape /ops/prometheus.
OPERATIONS_METRICS_TOKEN=
DATABASE_BACKUP_DIR=/var/backups/tanaghum/postgres
DATABASE_BACKUP_CRON=daily 02:15 UTC
BACKUP_MAX_AGE_SECONDS=93600
BACKUP_OFFSERVER_MAX_AGE_SECONDS=180000
RESTORE_DRILL_MAX_AGE_SECONDS=2678400
UPTIME_EVIDENCE_MAX_AGE_SECONDS=900
PUBLIC_APP_URL=
PUBLIC_HEALTH_URL=
UPTIME_CHECK_EVIDENCE_PATH=/var/lib/tanaghum/uptime/latest.json
ALERT_EVIDENCE_PATH=/var/lib/tanaghum/alerts/latest.json

# Customer/operations-owned values. Keep these outside Git.
ALERT_WEBHOOK_URL=
OPERATIONS_GITHUB_ALERTS_ENABLED=false
MFA_ENFORCE_PRIVILEGED_ENROLLMENT=false
MFA_ALLOW_PRIVILEGED_DISABLE=false
MFA_PRIVILEGED_ENFORCEMENT_EPOCH=0
BACKUP_RSYNC_TARGET=
BACKUP_S3_URI=
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/tanaghum/secrets/backup-passphrase
